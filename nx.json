{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.next"]
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "dev": {
      "cache": false
    }
  },
  "namedInputs": {
    "default": ["sharedGlobals", "{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/*.test.[jt]s?(x)"
    ],
    "sharedGlobals": []
  }
}
