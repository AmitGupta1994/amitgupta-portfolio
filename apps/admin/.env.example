# Postgres connection string.
# Local:  postgres://USER@localhost:5432/amitgupta_portfolio
# Neon:   postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Long random string, e.g. `openssl rand -hex 32`. Keep it stable: changing it logs everyone out.
PAYLOAD_SECRET=

# Public URL of this admin app; used for absolute media URLs and login cookies.
# Local: http://localhost:3001 — on Vercel leave empty and the deployment URL is used.
SERVER_URL=

# Frontend to notify when content changes; the secret must match the frontend's REVALIDATE_SECRET.
# Local: http://localhost:3000 — on Vercel: https://your-frontend.vercel.app
FRONTEND_URL=
REVALIDATE_SECRET=

# Vercel Blob storage for uploaded media. Required on Vercel (its filesystem is read-only);
# leave empty locally to store uploads in apps/admin/media.
BLOB_READ_WRITE_TOKEN=
