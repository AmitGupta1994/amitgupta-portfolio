# Postgres connection string.
# Local:  postgres://USER@localhost:5432/amitgupta_portfolio
# Neon:   postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Long random string, e.g. `openssl rand -hex 32`. Keep it stable: changing it logs everyone out.
PAYLOAD_SECRET=

# Vercel Blob storage for uploaded media. Required on Vercel (its filesystem is read-only);
# leave empty locally to store uploads in apps/frontend/media.
BLOB_READ_WRITE_TOKEN=
